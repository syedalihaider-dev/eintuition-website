# Database (required) — use Supabase Session pooler in production
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Auth (required)
JWT_SECRET="change-me-to-a-long-random-secret"

# Local: leave BASE_PATH empty (app at http://localhost:3000/)
# Live (subdirectory): NEXT_PUBLIC_BASE_PATH="/eintuition"
NEXT_PUBLIC_BASE_PATH=""

# Local:  https://localhost:3000  (Accept.js requires HTTPS — use npm run dev)
# Live:   https://your-domain.com/eintuition
NEXT_PUBLIC_APP_URL="https://localhost:3000"

# Authorize.net (sandbox or production)
AUTHORIZE_API_LOGIN_ID="your_api_login_id"
AUTHORIZE_TRANSACTION_KEY="your_transaction_key"
AUTHORIZE_ENVIRONMENT="sandbox"
AUTHORIZE_SIGNATURE_KEY=""
# Accept.js public keys (Account → Manage Public Client Key)
NEXT_PUBLIC_AUTHORIZE_API_LOGIN_ID="your_api_login_id"
NEXT_PUBLIC_AUTHORIZE_CLIENT_KEY="your_public_client_key"
NEXT_PUBLIC_AUTHORIZE_ENVIRONMENT="sandbox"

# Seed / first admin (optional)
ADMIN_EMAIL="eintuitionadmin@yopmail.com"
ADMIN_PASSWORD="Admin@123"

# cPanel / PM2
PORT=3000
NODE_ENV=production
